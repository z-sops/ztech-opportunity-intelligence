# ---- Persistence ---------------------------------------------------------
ZTECH_OI_DB_PATH=./data/ztech_oi.sqlite3
ZTECH_OI_LOG_LEVEL=INFO

# ---- Competitor discovery (one of these; without it only known_competitors are used)
BRAVE_API_KEY=
SERPER_API_KEY=
# ZTECH_OI_SEARCH_PROVIDER=brave        # force brave|serper when both are set

# ---- Optional LLM (classification / entity resolution only; never produces facts)
# Any OpenAI-compatible /chat/completions endpoint (OpenAI, OpenRouter, Groq, local vLLM...)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Meta Ad Library API (official, free; needs identity verification at facebook.com/ID)
META_ACCESS_TOKEN=
# Non-political ads are only returned for EU/UK delivery. Use EU/UK countries for reliable counts.
META_AD_COUNTRIES=DE,FR,GB

# ---- Google Ads Transparency Center (no official API) via SerpApi, labelled third-party
SERPAPI_API_KEY=

# ---- X / Twitter API v2 (paid tier with read access)
X_BEARER_TOKEN=

# ---- Limits (defaults are safe)
# ZTECH_OI_HTTP_TIMEOUT_S=12
# ZTECH_OI_HTTP_MAX_BYTES=3000000
# ZTECH_OI_HTTP_MAX_CONCURRENCY=8
# ZTECH_OI_PER_HOST_INTERVAL_S=0.5
# ZTECH_OI_PROVIDER_TIMEOUT_S=60
# ZTECH_OI_MAX_PAGES=8
