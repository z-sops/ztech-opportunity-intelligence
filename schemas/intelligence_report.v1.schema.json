          "type": "array"
        },
        "social_profiles": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Social Profiles",
          "type": "object"
        },
        "technologies": {
          "items": {
            "type": "string"
          },
          "title": "Technologies",
          "type": "array"
        },
        "locations": {
          "items": {
            "type": "string"
          },
          "title": "Locations",
          "type": "array"
        },
        "ctas": {
          "items": {
            "type": "string"
          },
          "title": "Ctas",
          "type": "array"
        },
        "offers": {
          "items": {
            "type": "string"
          },
          "title": "Offers",
          "type": "array"
        },
        "prices": {
          "items": {
            "type": "string"
          },
          "title": "Prices",
          "type": "array"
