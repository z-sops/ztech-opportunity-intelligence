{
  "$defs": {
    "Change": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "title": "Change Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ChangeType"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "website | content | meta_ads | google_ads | twitter",
          "title": "Channel"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "entity_name": {
          "title": "Entity Name",
          "type": "string"
        },
        "previous_snapshot_id": {
          "title": "Previous Snapshot Id",
          "type": "string"
        },
        "current_snapshot_id": {
          "title": "Current Snapshot Id",
          "type": "string"
        },
        "before": {
          "default": null,
          "title": "Before"
        },
        "after": {
          "default": null,
          "title": "After"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "claim_kind": {
          "$ref": "#/$defs/ClaimKind"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "change_id",
        "type",
        "entity_id",
        "entity_name",
        "previous_snapshot_id",
        "current_snapshot_id",
        "detail",
        "claim_kind",
        "confidence"
      ],
      "title": "Change",
      "type": "object"
    },
    "ChangeType": {
      "enum": [
        "NEW_PAGE",
        "REMOVED_PAGE",
        "NEW_ARTICLE",
        "NEW_OFFER",
        "NEW_AD_CREATIVE",
        "REMOVED_AD_CREATIVE",
        "AD_ACTIVITY_INCREASED",
        "AD_ACTIVITY_DECREASED",
        "CONTENT_ACTIVITY_INCREASED",
        "CONTENT_ACTIVITY_DECREASED",
        "NEW_COMPETITOR",
        "COMPETITOR_NOT_SEEN",
        "PROVIDER_AVAILABILITY_CHANGED",
        "PAGE_INVENTORY_CHANGED",
        "CTA_CHANGED",
        "SERVICES_CHANGED",
        "SOCIAL_ACTIVITY_INCREASED",
        "SOCIAL_ACTIVITY_DECREASED"
      ],
      "title": "ChangeType",
      "type": "string"
    },
    "ChannelSummary": {
      "additionalProperties": false,
      "description": "Per-entity, per-provider summary used in the report's *_intelligence sections.",
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProviderStatus"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "observation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Observation Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ProviderErrorInfo"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "provider",
        "status"
      ],
      "title": "ChannelSummary",
      "type": "object"
    },
    "ClaimKind": {
      "description": "ZTech epistemic categories. The engine produces only the first three.\n\nDECISION and ACTION belong to ZTech (human approval / outreach) and are\nnever produced here.",
      "enum": [
        "fact",
        "estimate",
        "inference"
      ],
      "title": "ClaimKind",
      "type": "string"
    },
    "CompanyProfile": {
      "additionalProperties": false,
