        "captured_at": {
          "title": "Captured At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "freshness": {
          "$ref": "#/$defs/FreshnessState",
          "default": "fresh"
        },
        "claim_kind": {
          "$ref": "#/$defs/ClaimKind"
        },
        "claim": {
          "maxLength": 600,
          "title": "Claim",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured metric key this evidence supports.",
          "title": "Metric"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/EstimateRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_reference": {
          "additionalProperties": true,
          "title": "Raw Reference",
          "type": "object"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "conflicts_with": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts With",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "entity_id",
        "provider",
        "source_type",
        "observation_type",
        "captured_at",
        "claim_kind",
        "claim",
        "confidence"
