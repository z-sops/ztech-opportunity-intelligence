          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Competitor Observed"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Topic scope (e.g. 'wedding cakes') for topic-scoped dimensions.",
          "title": "Topic"
        },
        "window": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        },
        "interpretation": {
          "$ref": "#/$defs/ComparisonInterpretation"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
